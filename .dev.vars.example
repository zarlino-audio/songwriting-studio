# Copy to `.dev.vars` for local development (git-ignored).
# In production, set each of these with: wrangler secret put <NAME>
#
# Secrets used by the Worker:
#
#   DEEPSEEK_API_KEY        - LLM provider key (used directly, or BYOK behind AI Gateway)
#   AI_GATEWAY_TOKEN        - Optional Cloudflare API token for the AI Gateway REST endpoint
#                             (needs AI Gateway + Workers AI permissions). If unset, the
#                             worker calls the provider directly using DEEPSEEK_API_KEY.
#   R2_ACCESS_KEY_ID        - R2 S3 API access key id  (R2 -> Manage R2 API Tokens)
#   R2_SECRET_ACCESS_KEY    - R2 S3 API secret         (enables direct browser upload/playback)
#   SESSION_PEPPER          - Random string mixed into password/session hashes
#   ANALYSIS_SHARED_SECRET  - Shared secret sent to the analysis service (X-Analysis-Key)
#   ANALYSIS_MACHINE_TOKEN  - Bearer token the polling analysis worker uses (npm run analysis:worker)

DEEPSEEK_API_KEY=
AI_GATEWAY_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SESSION_PEPPER=
ANALYSIS_SHARED_SECRET=
ANALYSIS_MACHINE_TOKEN=
